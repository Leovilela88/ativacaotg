# Railway > serviço > Variables

# Senha do painel /admin (obrigatória para ativar o admin)
ADMIN_PASSWORD=

# Cloudflare R2 > Manage API tokens (permissão Object Read & Write no bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Endereço público do bucket, sem barra no fim (r2.dev ou domínio próprio)
MEDIA_BASE_URL=https://pub-xxxx.r2.dev
